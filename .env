# ══════════════════════════════════════════════════════════════════════════════
#  Xpense Mobile App (Expo) — Environment Variables
#  ⚠️  This file is gitignored — safe to put real credentials here
# ══════════════════════════════════════════════════════════════════════════════

# ─── Firebase Web App Config (Frontend) ───────────────────────────────────────
# Fill these in from Firebase Console -> Project Settings -> General -> Your Apps (Web)
EXPO_PUBLIC_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-app-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-app.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef123456

# ─── Google OAuth Configuration ───────────────────────────────────────────────
# Get this from Firebase Console -> Authentication -> Sign-in method -> Google -> Web SDK configuration
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=440677710639-1s1gnnelqj2gjdlttljb3787th8904hs.apps.googleusercontent.com

# ─── API Base URL ──────────────────────────────────────────────────────────────
EXPO_PUBLIC_API_URL=https://xpense-nrwj-onrender.com


