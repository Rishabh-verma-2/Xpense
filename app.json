{
  "expo": {
    "name": "Xpense",
    "slug": "xpense",
    "scheme": "xpense",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/icon-512.png",
      "resizeMode": "contain",
      "backgroundColor": "#06060D"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.xpense.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#06060D"
      },
      "package": "com.xpense.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Xpense — Financial Tracker",
      "shortName": "Xpense",
      "themeColor": "#7C3AED",
      "backgroundColor": "#06060D",
      "display": "standalone",
      "orientation": "portrait",
      "startUrl": "/",
      "description": "Personal finance, budget tracking, and report analytics app."
    },
    "sdkVersion": "54.0.0",
    "plugins": [
      "expo-secure-store",
      "@react-native-google-signin/google-signin",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#7C3AED"
        }
      ]
    ]
  }
}
