{
  "expo": {
    "name": "Xpense",
    "slug": "xpense",
    "scheme": "xpense",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/splash_icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash_icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.xpense.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/splash_icon.png",
        "backgroundColor": "#0A0A0F"
      },
      "package": "com.xpense.app"
    },
    "web": {
      "favicon": "./assets/splash_icon.png",
      "name": "Xpense — Financial Tracker",
      "shortName": "Xpense",
      "themeColor": "#7C3AED",
      "backgroundColor": "#06060D",
      "display": "standalone",
      "orientation": "portrait",
      "startUrl": "/",
      "description": "Personal finance, budget tracking, and report analytics app."
    },
    "sdkVersion": "54.0.0",
    "plugins": [
      "expo-secure-store",
      "@react-native-google-signin/google-signin",
      "expo-web-browser"
    ]
  }
}
