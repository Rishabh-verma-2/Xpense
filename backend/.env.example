# ══════════════════════════════════════════════════════════════════════════════
#  Xpense Backend — Environment Variables
#  Copy this file to .env and fill in your values
#  ⚠️  NEVER commit .env to git — it's already in .gitignore
# ══════════════════════════════════════════════════════════════════════════════

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── MongoDB ──────────────────────────────────────────────────────────────────
# Your MongoDB Atlas password (used inside MONGO_URI below)
# Username MONGO = rishabhverma2626_db_user
MONGO_PASSWORD=gfgQLBwfuEP5AGWX

# Full connection URI — replace <username> and <cluster> with your Atlas values
# The password from MONGO_PASSWORD is interpolated automatically in database.ts
MONGO_URI=mongodb+srv://<db_username>:gfgQLBwfuEP5AGWX@cluster0.xcrmfla.mongodb.net/?appName=Cluster0

# Local MongoDB (alternative for dev — no Atlas needed)
# MONGO_URI=mongodb://localhost:27017/xpense

# Database name (used as a sanity label in logs)
MONGO_DB_NAME=xpense

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006,exp://localhost:19000

# ─── Firebase Admin SDK ───────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----"

